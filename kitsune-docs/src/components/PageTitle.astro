---
const { title } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top" class="kt-page-title" set:html={title} />

<style>
  .kt-page-title {
    font-family: var(--kt-display-font);
    font-weight: 400;
    font-variation-settings: 'opsz' 96, 'SOFT' 50;
    font-size: clamp(2.25rem, calc(1.5rem + 2.5vw), 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    color: var(--sl-color-text);
  }

  .kt-page-title::after {
    content: '';
    display: block;
    width: 56px;
    height: 4px;
    margin-top: 1rem;
    border-radius: 4px;
    background: var(--kt-sunset-stripe);
  }
</style>
